# ============================================================
# DRIVIN-TAT — variables de entorno para producción (Dokploy)
# Copia estas claves en el panel de Environment de Dokploy.
# NO subas el archivo .env real al repositorio.
# ============================================================

# Conexión a la base de datos PostgreSQL (remota)
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST:PUERTO/TATDRIVIN_DB?sslmode=require"

# Seguridad (usa una cadena larga y aleatoria)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# CORS / dominio público
CORS_ORIGIN="https://distrilog.grupo-santacruz.com"

# Integración Drivin
DRIVIN_API_URL="https://external.driv.in/api/external"
DRIVIN_API_KEY=""

# Integraciones Grupo Santacruz
CLIENTES_TAT_URL="https://apiconsulta.grupo-santacruz.com/clientes-tat"
TAT_INVOICES_URL="https://sigcom.grupo-santacruz.com/api/public/dispatch/tat-invoices?cia={cia}"
