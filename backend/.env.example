# Puerto del servidor Express
PORT=4000

# Entorno: development | production
NODE_ENV=development

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:3000

# Secreto para firmar los JWT (usa una cadena larga y aleatoria en producción)
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_EXPIRES_IN=7d

# API externa de Drivin (vehículos)
DRIVIN_API_URL=https://external.driv.in/api/external
DRIVIN_API_KEY=tu-api-key-de-drivin

# Cadena de conexión de PostgreSQL en la nube (Neon, Supabase, Railway, etc.)
# Ejemplo Neon: postgresql://usuario:password@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://usuario:password@host:5432/dbname?sslmode=require"
